mods.FollowerAddons.name=Follower Addons & Such

# Strawberry Blockfield Trigger
triggers.FollowerAddons/StrawberryBlockfieldTrigger.placements.name.blockfield_safe=Strawberry Blockfield Trigger (Safe)
triggers.FollowerAddons/StrawberryBlockfieldTrigger.placements.description.blockfield_safe=A Strawberry Blockfield that can persist through room transitions, save & quits, and deaths.\nAllows for berries to be returned to the player after dying for extra leniency.
triggers.FollowerAddons/StrawberryBlockfieldTrigger.placements.name.blockfield_unsafe=Strawberry Blockfield Trigger (Unsafe)
triggers.FollowerAddons/StrawberryBlockfieldTrigger.placements.description.blockfield_unsafe=A Strawberry Blockfield that can persist through room transitions, save & quits, and deaths.\nDoes not allow for berries to be returned to the player after dying.

triggers.FollowerAddons/StrawberryBlockfieldTrigger.attributes.name.keepOnDeath=Risk-Free
triggers.FollowerAddons/StrawberryBlockfieldTrigger.attributes.description.keepOnDeath=Whether or not to restore the player's strawberries when they die.
triggers.FollowerAddons/StrawberryBlockfieldTrigger.attributes.name.triggerOn=Enable
triggers.FollowerAddons/StrawberryBlockfieldTrigger.attributes.description.triggerOn=Enabled - Strawberries can't collect.\nDisabled - Strawberries can collect.
triggers.FollowerAddons/StrawberryBlockfieldTrigger.attributes.name.resetOnLeave=Reset On Leave

